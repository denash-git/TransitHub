<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>${INSTANCE_NAME} Access</title>
  <style>
    :root {
      --bg-a: #09131f;
      --bg-b: #1e2f3f;
      --glass: rgba(255,255,255,0.08);
      --line: rgba(255,255,255,0.16);
      --text: #edf5ff;
      --muted: #9fb4c8;
      --accent: #9ae6b4;
    }
    body {
      margin: 0;
      min-height: 100vh;
      font-family: "Segoe UI", sans-serif;
      color: var(--text);
      background: radial-gradient(circle at top, #34526b 0%, var(--bg-a) 35%, #03070d 100%);
      display: grid;
      place-items: center;
      padding: 24px;
    }
    .shell {
      width: min(820px, 100%);
      backdrop-filter: blur(18px);
      background: var(--glass);
      border: 1px solid var(--line);
      border-radius: 20px;
      overflow: hidden;
    }
    .bar {
      padding: 14px 18px;
      border-bottom: 1px solid var(--line);
      color: var(--muted);
    }
    .body { padding: 24px; }
    pre {
      white-space: pre-wrap;
      background: rgba(0,0,0,0.28);
      border-radius: 14px;
      padding: 16px;
      color: var(--accent);
    }
  </style>
</head>
<body>
  <section class="shell">
    <div class="bar">Instance ${INSTANCE_NAME} / ${DOMAIN}</div>
    <div class="body">
      <h1>Subscription helper</h1>
      <pre id="out"></pre>
    </div>
  </section>
  <script>
    const client = new URL(location.href).searchParams.get("name") || "first";
    const base = "https://${DOMAIN}";
    document.getElementById("out").textContent = [
      `client=${client}`,
      `sub=${base}/${SUB_PATH}/${client}`,
      `json=${base}/${JSON_PATH}/${client}`,
      `clash=${base}/${WEB_PATH}/clash.yaml?name=${client}`
    ].join("\n");
  </script>
</body>
</html>
